# Copy to cms/.env.local and fill in. Never commit the filled version.
#
# GitHub OAuth app (Settings -> Developer settings -> OAuth Apps -> New):
#   Homepage URL:               http://localhost:3000/
#   Authorization callback URL: http://localhost:3000/api/outstatic/callback
# One OAuth app supports exactly ONE callback URL. Keeping the dashboard
# localhost-only means these credentials never leave your machine.
OST_GITHUB_ID=
OST_GITHUB_SECRET=

# Which repository the editor commits into. Slug is the NAME only, no owner.
OST_REPO_OWNER=libredb
OST_REPO_SLUG=libredb.github.io
# Documented as defaulting to "main", but 2.2.4 reads it as `|| ''` and every
# GitHub query is gated on it being truthy — set it explicitly or the dashboard
# silently shows no content.
OST_REPO_BRANCH=main

# Content lives at the repo ROOT, which is where Astro's glob loader reads it.
OST_CONTENT_PATH=outstatic/content

# MUST STAY COMMENTED OUT. It is a prefix prepended to EVERY repo path, so
# setting it to "cms" would write content to cms/outstatic/content/** instead of
# the repo root — the opposite of what this layout wants.
# OST_MONOREPO_PATH=

# Uploads land in the Astro site's public/ directory.
OST_REPO_MEDIA_PATH=public/images/
OST_PUBLIC_MEDIA_PATH=images/

# Optional. If set it must be at least 32 bytes: openssl rand -base64 32
# If unset, the session key is derived from OST_GITHUB_SECRET.
# OST_TOKEN_SECRET=

# Optional: AI completions inside the editor.
# OPENAI_API_KEY=
