{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*.ts", "**/*.tsx", "**/*.astro", "site.config.json"],
  "exclude": ["dist", "node_modules", "cms", "design", "design-system"],
  "compilerOptions": {
    "resolveJsonModule": true,
    "allowJs": true,
    "strictNullChecks": true,
    "types": ["bun"]
  }
}
