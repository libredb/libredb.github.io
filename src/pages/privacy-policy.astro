---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Privacy Policy - LibreDB Studio" description="Privacy Policy for LibreDB Studio. Learn how we handle cookies, analytics data, and your privacy rights under GDPR.">
  <Header />
  <main class="pt-24 pb-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl sm:text-4xl font-bold text-bright mb-2">Privacy Policy</h1>
      <p class="text-sm text-muted mb-12">Last updated: March 1, 2026</p>

      <!-- Introduction -->
      <section class="mb-10">
        <h2 class="text-xl font-semibold text-bright mb-4">Introduction</h2>
        <p class="text-fg leading-relaxed">
          LibreDB Studio ("we", "our", or "us") respects your privacy. This Privacy Policy explains how we collect,
          use, and protect information when you visit our website at
          <a href="https://libredb.org" class="text-primary hover:text-primary-bright underline underline-offset-2">libredb.org</a>.
          LibreDB Studio is an open-source project and this website serves as its landing page.
        </p>
      </section>

      <!-- Information We Collect -->
      <section class="mb-10">
        <h2 class="text-xl font-semibold text-bright mb-4">Information We Collect</h2>
        <p class="text-fg leading-relaxed mb-4">
          We do not require you to create an account or provide personal information to use this website.
          The only data we collect is through analytics cookies, and only if you give your consent.
        </p>
        <p class="text-fg leading-relaxed">
          When you consent to analytics, the following services may collect data:
        </p>
        <h3 class="text-lg font-medium text-bright mt-4 mb-2">Google Analytics</h3>
        <p class="text-fg leading-relaxed">
          Google Analytics may collect:
        </p>
        <ul class="mt-3 space-y-2 text-fg list-disc list-inside">
          <li>Pages visited and time spent on each page</li>
          <li>Referring website or source</li>
          <li>Browser type and operating system</li>
          <li>Approximate geographic location (country/city level)</li>
          <li>Device type (desktop, mobile, tablet)</li>
        </ul>

        <h3 class="text-lg font-medium text-bright mt-6 mb-2">Meta (Facebook) Pixel</h3>
        <p class="text-fg leading-relaxed">
          When you accept cookies, Meta Pixel may collect:
        </p>
        <ul class="mt-3 space-y-2 text-fg list-disc list-inside">
          <li>Pages visited (PageView events)</li>
          <li>Browser and device information</li>
          <li>Approximate geographic location</li>
          <li>Referring URL</li>
        </ul>
        <p class="text-fg leading-relaxed mt-3">
          This data is processed by Meta under their
          <a href="https://www.facebook.com/privacy/policy/" target="_blank" rel="noopener noreferrer" class="text-primary hover:text-primary-bright underline underline-offset-2">Privacy Policy</a>.
          Meta Pixel is only loaded after you explicitly accept cookies.
        </p>
      </section>

      <!-- Cookies -->
      <section class="mb-10">
        <h2 class="text-xl font-semibold text-bright mb-4">Cookies</h2>
        <p class="text-fg leading-relaxed mb-4">
          Cookies are small text files stored on your device. Below is a summary of the cookies used on this site:
        </p>
        <div class="overflow-x-auto border border-edge">
          <table class="w-full text-sm text-left">
            <thead class="bg-panel text-fg uppercase text-xs tracking-wider">
              <tr>
                <th class="px-4 py-3">Cookie</th>
                <th class="px-4 py-3">Provider</th>
                <th class="px-4 py-3">Purpose</th>
                <th class="px-4 py-3">Duration</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-edge">
              <tr class="bg-panel">
                <td class="px-4 py-3 text-fg font-mono text-xs">_ga</td>
                <td class="px-4 py-3 text-muted">Google Analytics</td>
                <td class="px-4 py-3 text-muted">Distinguishes unique visitors</td>
                <td class="px-4 py-3 text-muted">2 years</td>
              </tr>
              <tr class="bg-canvas">
                <td class="px-4 py-3 text-fg font-mono text-xs">_ga_*</td>
                <td class="px-4 py-3 text-muted">Google Analytics</td>
                <td class="px-4 py-3 text-muted">Maintains session state</td>
                <td class="px-4 py-3 text-muted">2 years</td>
              </tr>
              <tr class="bg-panel">
                <td class="px-4 py-3 text-fg font-mono text-xs">_fbp</td>
                <td class="px-4 py-3 text-muted">Meta (Facebook) Pixel</td>
                <td class="px-4 py-3 text-muted">Stores and tracks visits across websites</td>
                <td class="px-4 py-3 text-muted">3 months</td>
              </tr>
              <tr class="bg-canvas">
                <td class="px-4 py-3 text-fg font-mono text-xs">fr</td>
                <td class="px-4 py-3 text-muted">Meta (Facebook) Pixel</td>
                <td class="px-4 py-3 text-muted">Enables ad delivery and measurement</td>
                <td class="px-4 py-3 text-muted">3 months</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="text-muted text-sm mt-3">
          We also store your cookie consent preference in <code class="text-primary bg-raised px-1.5 py-0.5 rounded text-xs">localStorage</code>
          (key: <code class="text-primary bg-raised px-1.5 py-0.5 rounded text-xs">libredb-cookie-consent</code>).
          This is not a cookie and is not sent to any server.
        </p>
      </section>

      <!-- Your Choices -->
      <section class="mb-10">
        <h2 class="text-xl font-semibold text-bright mb-4">Your Choices</h2>
        <p class="text-fg leading-relaxed mb-4">
          When you first visit our site, a cookie consent banner will appear. You can choose to:
        </p>
        <ul class="space-y-2 text-fg list-disc list-inside">
          <li><strong class="text-bright">Accept</strong> &mdash; analytics cookies will be set and Google Analytics will load.</li>
          <li><strong class="text-bright">Decline</strong> &mdash; no analytics cookies will be set and Google Analytics will not load.</li>
        </ul>
        <p class="text-fg leading-relaxed mt-4">
          You can change your preference at any time by clearing your browser's local storage for this site and reloading the page.
        </p>
      </section>

      <!-- Data Sharing -->
      <section class="mb-10">
        <h2 class="text-xl font-semibold text-bright mb-4">Data Sharing</h2>
        <p class="text-fg leading-relaxed">
          If you accept analytics cookies, anonymized usage data is processed by Google Analytics under
          Google's <a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer" class="text-primary hover:text-primary-bright underline underline-offset-2">Privacy Policy</a>.
          We do not sell, rent, or share your personal data with any other third parties.
        </p>
      </section>

      <!-- Data Retention -->
      <section class="mb-10">
        <h2 class="text-xl font-semibold text-bright mb-4">Data Retention</h2>
        <p class="text-fg leading-relaxed">
          Google Analytics data is retained for 14 months, after which it is automatically deleted.
          Your consent preference stored in local storage persists until you clear it manually.
        </p>
      </section>

      <!-- GDPR Rights -->
      <section class="mb-10">
        <h2 class="text-xl font-semibold text-bright mb-4">Your Rights Under GDPR</h2>
        <p class="text-fg leading-relaxed mb-4">
          If you are located in the European Economic Area (EEA), you have the following rights:
        </p>
        <ul class="space-y-2 text-fg list-disc list-inside">
          <li><strong class="text-bright">Right to access</strong> &mdash; request a copy of the data we hold about you.</li>
          <li><strong class="text-bright">Right to rectification</strong> &mdash; request correction of inaccurate data.</li>
          <li><strong class="text-bright">Right to erasure</strong> &mdash; request deletion of your data.</li>
          <li><strong class="text-bright">Right to restrict processing</strong> &mdash; request that we limit how we use your data.</li>
          <li><strong class="text-bright">Right to data portability</strong> &mdash; request your data in a machine-readable format.</li>
          <li><strong class="text-bright">Right to object</strong> &mdash; object to our processing of your data.</li>
          <li><strong class="text-bright">Right to withdraw consent</strong> &mdash; withdraw your consent at any time by clearing local storage.</li>
        </ul>
      </section>

      <!-- Children's Privacy -->
      <section class="mb-10">
        <h2 class="text-xl font-semibold text-bright mb-4">Children's Privacy</h2>
        <p class="text-fg leading-relaxed">
          This website is not directed at children under 16. We do not knowingly collect personal data from children.
        </p>
      </section>

      <!-- Changes to This Policy -->
      <section class="mb-10">
        <h2 class="text-xl font-semibold text-bright mb-4">Changes to This Policy</h2>
        <p class="text-fg leading-relaxed">
          We may update this Privacy Policy from time to time. Changes will be posted on this page with an updated
          "Last updated" date. We encourage you to review this page periodically.
        </p>
      </section>

      <!-- Contact -->
      <section class="mb-10">
        <h2 class="text-xl font-semibold text-bright mb-4">Contact</h2>
        <p class="text-fg leading-relaxed">
          If you have questions about this Privacy Policy, please open an issue on our
          <a href="https://github.com/libredb/libredb-studio/issues" target="_blank" rel="noopener noreferrer" class="text-primary hover:text-primary-bright underline underline-offset-2">GitHub repository</a>.
        </p>
      </section>

      <!-- Back to Home -->
      <div class="pt-6 border-t border-edge">
        <a
          href="/"
          class="inline-flex items-center gap-2 text-sm text-primary hover:text-primary-bright transition-colors"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
          Back to Home
        </a>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
