---
import BaseLayout from '../layouts/BaseLayout.astro';
import { navLinks } from '../data/home';
---

<BaseLayout path="/404" title="Page not found" description="That page does not exist." noindex>
  <section class="nf" aria-labelledby="nf-title">
    <div class="nf__inner u-container">
      <p class="nf__code">404</p>
      <h1 class="nf__title" id="nf-title">That page is not here</h1>
      <p class="nf__body">
        The link may be old, or the page may have moved into the repository's docs. Everything the site covers is one of
        these:
      </p>
      <ul class="nf__links">
        <li><a href="/">Home</a></li>
        {
          navLinks.map((l) => (
            <li>
              <a href={`/${l.href}`}>{l.label}</a>
            </li>
          ))
        }
        <li><a href="/blog">Blog</a></li>
        <li><a href="/faq">FAQ</a></li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .nf__inner {
    padding-block: clamp(var(--space-12), 14vh, var(--space-15));
    max-width: var(--measure-long);
  }
  .nf__code {
    font: var(--weight-semibold) var(--body-xs-size) / 1 var(--font-mono);
    letter-spacing: var(--eyebrow-tracking);
    color: var(--text-brand);
  }
  .nf__title {
    margin-top: var(--stack-eyebrow-title);
    font-family: var(--font-heading);
    font-weight: var(--weight-semibold);
    font-size: clamp(var(--h1-size-mobile), 3.6vw, 46px);
    line-height: 1.1;
    letter-spacing: -0.024em;
  }
  .nf__body {
    margin-top: var(--stack-title-body);
    font-size: 17px;
    line-height: 1.7;
    color: var(--text-secondary);
  }
  .nf__links {
    margin: var(--space-08) 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-03);
  }
  .nf__links a {
    display: inline-flex;
    align-items: center;
    min-height: 34px;
    padding: 0 14px;
    border: var(--border-width-1) solid var(--border);
    border-radius: var(--radius-pill);
    font: var(--weight-medium) 13px / 1 var(--font-ui);
    color: var(--text-secondary);
    transition:
      color var(--duration-fast) var(--ease-out),
      background var(--duration-fast) var(--ease-out);
  }
  .nf__links a:hover {
    background: var(--surface-hover);
    color: var(--text-primary);
  }
</style>
