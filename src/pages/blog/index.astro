---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/blog/PostCard.astro';
import { pagePath, site } from '../../lib/site';
import { engineName, postEngine } from '../../lib/posts';

const posts = (await getCollection('posts', ({ data }) => data.status === 'published')).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);

// A way into 104 posts that is not "scroll". These are plain links to the
// archives rather than a client-side filter: the grouping is then crawlable,
// linkable and survives with JavaScript off, and the work is already done.
const byEngine = new Map<string, number>();
for (const post of posts) {
  const id = postEngine(post.id);
  if (id) byEngine.set(id, (byEngine.get(id) ?? 0) + 1);
}
const archives = [...byEngine.entries()]
  .filter(([, n]) => n >= 2)
  .map(([id, n]) => ({ id, n, name: engineName(id) ?? id }))
  .sort((a, b) => b.n - a.n || a.name.localeCompare(b.name));
---

<BaseLayout
  path="/blog"
  title="Blog"
  description="A dated record of the discussions, notes and decisions behind LibreDB Studio, and continuing writing on databases, SQL and NoSQL, LLMs and agents."
>
  <section class="blog" aria-labelledby="blog-title">
    <div class="u-wash blog__wash" aria-hidden="true"></div>
    <div class="blog__inner u-container">
      <header class="blog__head">
        <p class="u-eyebrow">Blog</p>
        <h1 class="blog__title" id="blog-title">
          Notes, arguments and <span class="u-grad-brand">the decisions they turned into</span>
        </h1>
        <p class="blog__intro">
          A dated record of what we discussed, what broke afterwards and what we chose to do about it — kept as written
          rather than tidied up. It continues into the work in front of us: databases, SQL and NoSQL, LLMs and agents.
        </p>
        <p class="blog__feed">
          <a href="/rss.xml">RSS feed →</a>
          <span aria-hidden="true">·</span>
          <a href={site.links.github} target="_blank" rel="noreferrer">GitHub ↗</a>
        </p>
        {
          archives.length > 0 && (
            <nav class="blog__engines" aria-label="Posts by engine">
              <p class="blog__engineslabel">By engine</p>
              <ul>
                {archives.map((e) => (
                  <li>
                    <a href={pagePath(`/blog/engine/${e.id}`)}>
                      {e.name}
                      <span class="blog__enginecount">{e.n}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }
      </header>

      {
        posts.length === 0 ? (
          <div class="blog__empty">
            <p class="blog__emptytitle">No posts published yet</p>
            <p class="blog__emptybody">
              The first write-up is being drafted. In the meantime the architecture notes live in the repository's docs
              folder.
            </p>
            <a class="blog__emptycta" href={site.links.docs} target="_blank" rel="noreferrer">
              Read the docs ↗
            </a>
          </div>
        ) : (
          <div class="blog__grid">
            {posts.map((post, i) => (
              <PostCard post={post} featured={i === 0} />
            ))}
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .blog__engines {
    margin-top: var(--space-07);
  }
  .blog__engineslabel {
    font: var(--weight-semibold) var(--overline-size) / 1 var(--font-mono);
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--text-tertiary);
  }
  .blog__engines ul {
    margin: var(--space-04) 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-03);
  }
  .blog__engines a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-02);
    min-height: 32px;
    padding-inline: var(--space-04);
    border: var(--border-width-1) solid var(--border);
    border-radius: var(--radius-pill);
    font: var(--weight-medium) 13px / 1 var(--font-mono);
    color: var(--text-secondary);
  }
  .blog__engines a:hover {
    border-color: var(--border-strong);
    color: var(--text-primary);
  }
  .blog__enginecount {
    color: var(--text-tertiary);
    font-variant-numeric: tabular-nums;
  }

  .blog {
    position: relative;
    overflow: hidden;
  }
  .blog__wash {
    background: radial-gradient(
      700px 420px at 50% -10%,
      color-mix(in srgb, var(--primary-600) 10%, transparent),
      transparent 70%
    );
  }
  .blog__inner {
    position: relative;
    padding-block: clamp(var(--section-y-tablet), 9vh, 96px) clamp(var(--section-y-desktop), 10vh, 112px);
  }
  .blog__head {
    max-width: var(--measure-long);
  }
  .blog__title {
    margin-top: var(--stack-eyebrow-title);
    font-family: var(--font-heading);
    font-weight: var(--weight-semibold);
    font-size: clamp(var(--h1-size-mobile), 3.6vw, 46px);
    line-height: 1.1;
    letter-spacing: -0.024em;
    text-wrap: balance;
  }
  .blog__intro {
    margin-top: var(--stack-title-body);
    font-size: 17px;
    line-height: 1.7;
    color: var(--text-secondary);
    text-wrap: pretty;
  }
  .blog__feed {
    margin-top: var(--space-06);
    display: flex;
    align-items: center;
    gap: var(--space-04);
    font: var(--weight-medium) 12.5px / 1 var(--font-mono);
    color: var(--text-tertiary);
  }
  .blog__feed a {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    color: var(--text-secondary);
  }
  .blog__feed a:hover {
    color: var(--text-primary);
  }

  .blog__grid {
    margin-top: clamp(var(--space-09), 5vw, var(--space-11));
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(340px, 100%), 1fr));
    gap: var(--space-05);
  }
  .blog__grid > :global(.pcard--featured) {
    grid-column: 1 / -1;
  }

  .blog__empty {
    margin-top: var(--space-10);
    padding: clamp(var(--space-09), 6vw, var(--space-12)) var(--card-padding);
    border: 1.5px dashed var(--border-strong);
    border-radius: var(--radius-xl);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-04);
  }
  .blog__emptytitle {
    font-family: var(--font-heading);
    font-weight: var(--weight-semibold);
    font-size: var(--h4-size);
    color: var(--text-primary);
  }
  .blog__emptybody {
    max-width: var(--measure-short);
    font-size: var(--body-s-size);
    line-height: 1.65;
    color: var(--text-secondary);
  }
  .blog__emptycta {
    margin-top: var(--space-03);
    display: inline-flex;
    align-items: center;
    height: 44px;
    padding: 0 18px;
    border-radius: var(--radius-m);
    background: var(--action-primary);
    color: #fff;
    font: var(--weight-medium) var(--button-m-size) / 1 var(--font-ui);
  }
  .blog__emptycta:hover {
    background: var(--action-primary-hover);
    color: #fff;
  }
</style>
