---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TableOfContents from '../../components/blog/TableOfContents.astro';
import { formatDate, isoDate, readingTime } from '../../lib/format';
import { site } from '../../lib/site';

// PITFALLS B5: getStaticPaths is extracted into its own module at build time, so
// nothing defined in the rest of this frontmatter is visible inside it. Every
// helper it uses is either imported or declared within the function body.
export const getStaticPaths = (async () => {
  const { getCollection } = await import('astro:content');
  const posts = await getCollection('posts', ({ data }) => data.status === 'published');
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

type Props = { post: CollectionEntry<'posts'> };
const { post } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, publishedAt, author, tags, coverImage } = post.data;

const all = (await getCollection('posts', ({ data }) => data.status === 'published')).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);
const others = all.filter((p) => p.id !== post.id).slice(0, 2);

const minutes = readingTime(post.body ?? '');

const schema = [
  {
    '@type': 'BlogPosting',
    headline: title,
    description,
    datePublished: publishedAt.toISOString(),
    inLanguage: 'en',
    author: { '@type': 'Organization', name: author.name || site.name },
    publisher: { '@id': `${site.url}/#organization` },
    mainEntityOfPage: `${site.url}/blog/${post.id}`,
  },
];
---

<BaseLayout
  path={`/blog/${post.id}`}
  title={title}
  description={description}
  type="article"
  image={coverImage || undefined}
  publishedTime={publishedAt.toISOString()}
  authors={[author.name || site.name]}
  schema={schema}
>
  <article class="post">
    <div class="post__inner u-container">
      <p class="post__back"><a href="/blog">← All posts</a></p>

      <header class="post__head">
        {
          tags.length > 0 && (
            <p class="post__tags">
              {tags.map((t) => (
                <span class="post__tag">{t.label}</span>
              ))}
            </p>
          )
        }
        <h1 class="post__title">{title}</h1>
        <p class="post__lede">{description}</p>
        <p class="post__meta">
          <time datetime={isoDate(publishedAt)}>{formatDate(publishedAt)}</time>
          <span aria-hidden="true">·</span>
          <span>{`${minutes} min read`}</span>
          {
            author.name && (
              <>
                <>
                  <span aria-hidden="true">·</span>
                  <span>{author.name}</span>
                </>
              </>
            )
          }
        </p>
      </header>

      {coverImage && <img class="post__cover" src={coverImage} alt="" loading="lazy" />}

      <div class="post__grid">
        <div class="post__body prose"><Content /></div>
        <TableOfContents headings={headings} />
      </div>

      {
        others.length > 0 && (
          <aside class="post__more" aria-label="Keep reading">
            <p class="post__morelabel">Keep reading</p>
            <ul class="post__morelist">
              {others.map((p) => (
                <li>
                  <a href={`/blog/${p.id}`}>
                    <span class="post__moretitle">{p.data.title}</span>
                    <span class="post__moredate">{formatDate(p.data.publishedAt)}</span>
                  </a>
                </li>
              ))}
            </ul>
          </aside>
        )
      }
    </div>
  </article>
</BaseLayout>

<style>
  .post__inner {
    padding-block: clamp(var(--space-09), 6vh, 72px) clamp(var(--section-y-desktop), 10vh, 112px);
  }
  .post__back {
    font: var(--weight-medium) 12.5px / 1 var(--font-mono);
  }
  .post__back a {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    color: var(--text-tertiary);
  }
  .post__back a:hover {
    color: var(--text-primary);
  }

  .post__head {
    margin-top: var(--space-08);
    max-width: var(--measure-long);
  }
  .post__tags {
    display: flex;
    gap: var(--space-03);
    flex-wrap: wrap;
  }
  .post__tag {
    font: var(--weight-semibold) var(--overline-size) / 1 var(--font-mono);
    letter-spacing: var(--overline-tracking);
    text-transform: uppercase;
    color: var(--text-brand);
  }
  .post__title {
    margin-top: var(--space-04);
    font-family: var(--font-heading);
    font-weight: var(--weight-semibold);
    font-size: clamp(var(--h1-size-mobile), 3.6vw, 44px);
    line-height: 1.1;
    letter-spacing: -0.024em;
    text-wrap: balance;
  }
  .post__lede {
    margin-top: var(--space-05);
    font-size: var(--body-l-size);
    line-height: 1.65;
    color: var(--text-secondary);
    text-wrap: pretty;
  }
  .post__meta {
    margin-top: var(--space-06);
    display: flex;
    align-items: center;
    gap: var(--space-03);
    flex-wrap: wrap;
    font: var(--weight-medium) var(--meta-size) / 1.4 var(--font-mono);
    letter-spacing: 0.04em;
    color: var(--text-tertiary);
  }

  .post__cover {
    margin-top: var(--space-09);
    width: 100%;
    border-radius: var(--radius-2xl);
    border: var(--border-width-1) solid var(--border);
  }

  .post__grid {
    margin-top: clamp(var(--space-09), 5vh, var(--space-11));
    display: grid;
    grid-template-columns: minmax(0, var(--measure-long)) minmax(0, 240px);
    gap: clamp(var(--space-08), 5vw, 72px);
    align-items: start;
  }

  .post__more {
    margin-top: clamp(var(--space-11), 8vh, var(--space-13));
    padding-top: var(--space-08);
    border-top: var(--border-width-1) solid var(--border);
  }
  .post__morelabel {
    font: var(--weight-semibold) var(--overline-size) / 1 var(--font-mono);
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--text-tertiary);
  }
  .post__morelist {
    margin: var(--space-06) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: var(--space-05);
  }
  .post__morelist a {
    display: flex;
    flex-direction: column;
    gap: var(--space-03);
    padding: var(--card-padding);
    border: var(--border-width-1) solid var(--border);
    border-radius: var(--radius-l);
    background: var(--surface);
    transition:
      transform var(--duration-normal) var(--ease-out),
      box-shadow var(--duration-normal) var(--ease-out);
  }
  .post__morelist a:hover {
    transform: translateY(var(--hover-lift));
    box-shadow: var(--shadow-l);
  }
  .post__moretitle {
    font-family: var(--font-heading);
    font-weight: var(--weight-semibold);
    font-size: var(--h5-size);
    line-height: var(--h5-line);
    color: var(--text-primary);
  }
  .post__moredate {
    font: var(--weight-medium) var(--meta-size) / 1 var(--font-mono);
    color: var(--text-tertiary);
  }

  @media (max-width: 1023px) {
    .post__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
