---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import WhySection from '../components/home/WhySection.astro';
import FlowBand from '../components/home/FlowBand.astro';
import HowSection from '../components/home/HowSection.astro';
import EnginesSection from '../components/home/EnginesSection.astro';
import ProductSection from '../components/home/ProductSection.astro';
import FeaturesSection from '../components/home/FeaturesSection.astro';
import OpenSourceSection from '../components/home/OpenSourceSection.astro';
import DeploySection from '../components/home/DeploySection.astro';
import CtaBand from '../components/home/CtaBand.astro';
import { site } from '../lib/site';
import { engines } from '../data/engines';

const schema = [
  {
    '@type': 'SoftwareApplication',
    name: site.name,
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'Web browser, Docker, Kubernetes',
    description: site.description,
    softwareVersion: site.version,
    url: site.url,
    license: 'https://opensource.org/licenses/MIT',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    featureList: engines.map((e) => e.name),
  },
];
---

<BaseLayout path="/" schema={schema}>
  <Hero />
  <WhySection><FlowBand slot="flow" /></WhySection>
  <HowSection />
  <EnginesSection />
  <ProductSection />
  <FeaturesSection />
  <OpenSourceSection />
  <DeploySection />
  <CtaBand />
</BaseLayout>
