---
import BaseLayout from '../layouts/BaseLayout.astro';
import CopyBox from '../components/common/CopyBox.astro';
import { deploy, how } from '../data/home';
import { site } from '../lib/site';

type CommandTab = Extract<(typeof deploy.tabs)[number], { command: string }>;
const commands = deploy.tabs.filter((t): t is CommandTab => 'command' in t);
---

<BaseLayout
  path="/get-started"
  title="Get started"
  description="Run LibreDB Studio next to your database in about a minute — one container, one npx command, a Helm release or a one-click template."
>
  <section class="gs" aria-labelledby="gs-title">
    <div class="u-wash gs__wash" aria-hidden="true"></div>
    <div class="gs__inner u-container">
      <p class="u-eyebrow">Get started</p>
      <h1 class="gs__title" id="gs-title">
        Running next to your database in <span class="u-grad-brand">about a minute</span>
      </h1>
      <p class="gs__intro">
        Studio is one container. Put it on the network the database already lives on, open the URL, and sign the team
        in. Nothing is installed on anyone's laptop.
      </p>

      <ol class="gs__steps">
        {
          how.steps.map((s) => (
            <li class="gs__step">
              <p class="gs__n">{s.n}</p>
              <h2 class="gs__stept">{s.t}</h2>
              <p class="gs__stepd">{s.d}</p>
            </li>
          ))
        }
      </ol>

      <h2 class="gs__h2" id="gs-commands">Pick an install channel</h2>
      <div class="gs__cmds">
        {
          commands.map((t) => (
            <div class="gs__cmd">
              <p class="gs__cmdlabel">{t.label}</p>
              <CopyBox command={t.command} label={`Copy the ${t.label} command`} />
              <p class="gs__cmdnote">{t.note}</p>
            </div>
          ))
        }
      </div>

      <p class="gs__more">
        One-click templates for Railway, Dokploy, CapRover, DigitalOcean, Sealos and Fly.io, plus the Helm chart and its
        certified Rancher Partner Charts listing, are on the deploy page with the rest.
        <a href={site.links.distribution} target="_blank" rel="noreferrer">Every channel ↗</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .gs {
    position: relative;
    overflow: hidden;
  }
  .gs__wash {
    background: radial-gradient(
      700px 420px at 50% -10%,
      color-mix(in srgb, var(--primary-600) 10%, transparent),
      transparent 70%
    );
  }
  .gs__inner {
    position: relative;
    padding-block: clamp(var(--section-y-desktop), 10vh, 112px);
  }
  .gs__title {
    margin-top: var(--stack-eyebrow-title);
    max-width: var(--measure-long);
    font-family: var(--font-heading);
    font-weight: var(--weight-semibold);
    font-size: clamp(var(--h1-size-mobile), 3.6vw, 46px);
    line-height: 1.1;
    letter-spacing: -0.024em;
    text-wrap: balance;
  }
  .gs__intro {
    margin-top: var(--stack-title-body);
    max-width: var(--measure-long);
    font-size: 17px;
    line-height: 1.7;
    color: var(--text-secondary);
    text-wrap: pretty;
  }

  .gs__steps {
    margin: clamp(var(--space-09), 5vw, var(--space-11)) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
    gap: 14px;
  }
  .gs__step {
    background: var(--surface);
    border: var(--border-width-1) solid var(--border);
    border-radius: var(--radius-l);
    padding: var(--card-padding);
  }
  .gs__n {
    font: var(--weight-semibold) var(--body-xs-size) / 1 var(--font-mono);
    letter-spacing: 0.14em;
    color: var(--text-tertiary);
  }
  .gs__stept {
    margin-top: var(--space-04);
    font-family: var(--font-heading);
    font-weight: var(--weight-semibold);
    font-size: var(--h5-size);
    line-height: 1.3;
  }
  .gs__stepd {
    margin-top: var(--space-03);
    font-size: 14.5px;
    line-height: 1.65;
    color: var(--text-secondary);
    text-wrap: pretty;
  }

  .gs__h2 {
    margin-top: clamp(var(--space-11), 7vh, var(--space-12));
    font-family: var(--font-heading);
    font-weight: var(--weight-semibold);
    font-size: var(--h3-size);
    line-height: var(--h3-line);
    letter-spacing: var(--h3-tracking);
  }
  .gs__cmds {
    margin-top: var(--space-07);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(420px, 100%), 1fr));
    gap: var(--space-06);
  }
  .gs__cmd {
    display: flex;
    flex-direction: column;
    gap: var(--space-03);
  }
  .gs__cmdlabel {
    font: var(--weight-semibold) var(--overline-size) / 1 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-tertiary);
  }
  .gs__cmdnote {
    font: var(--weight-regular) var(--body-xs-size) / 1.5 var(--font-mono);
    color: var(--text-tertiary);
  }
  .gs__more {
    margin-top: var(--space-09);
    max-width: var(--measure-long);
    font-size: var(--body-s-size);
    line-height: 1.7;
    color: var(--text-secondary);
  }
</style>
