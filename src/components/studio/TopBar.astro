---
const GITHUB = 'https://github.com/libredb/libredb-studio';
const DEMO = 'https://app.libredb.org';
---

<header class="flex h-12 shrink-0 items-center justify-between border-b border-edge bg-canvas pr-4 pl-3 text-[13px]">
  <!-- Brand + connection -->
  <div class="flex items-center gap-3">
    <a href="/" class="flex items-center gap-2 font-semibold text-bright">
      <img src="/logo.svg" alt="LibreDB Studio" class="h-5 w-5" />
      <span>LibreDB Studio</span>
    </a>
    <span class="flex cursor-default items-center gap-2 text-faint select-none" aria-hidden="true">
      <span>▤</span>
      <span>＋</span>
    </span>
    <span class="mx-1 h-5 w-px bg-edge-strong" aria-hidden="true"></span>
    <span class="flex items-center gap-2">
      <span class="text-primary" aria-hidden="true">▦</span>
      <span class="text-fg">libredb.org</span>
      <span class="cursor-default text-[11px] tracking-wider text-faint select-none" aria-hidden="true"
        >PRODUCTION • ONLINE</span
      >
    </span>
  </div>

  <!-- Status + actions -->
  <div class="flex items-center gap-4 text-[12.5px]">
    <a
      href={GITHUB}
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center gap-1.5 text-muted hover:text-fg"
    >
      <span class="text-warn" aria-hidden="true">★</span> GitHub
    </a>
    <span class="flex cursor-default items-center gap-1.5 text-ok select-none">
      <span class="h-2 w-2 animate-pulse-dot rounded-full bg-ok" aria-hidden="true"></span> Online
    </span>
    <button
      type="button"
      class="flex items-center gap-1.5 text-muted hover:text-fg"
      data-action="notice"
      data-notice="monitoring"><span aria-hidden="true">◷</span> Monitoring</button
    >
    <a href="/playground" class="flex items-center gap-1.5 text-muted hover:text-fg">
      <span class="text-primary" aria-hidden="true">▶</span> Playground
    </a>
    <button
      type="button"
      class="hidden items-center gap-1.5 rounded-md border border-edge-strong px-2 py-1 text-[11.5px] text-faint hover:text-fg xl:flex"
      data-action="palette"
      aria-label="Open command palette">⌘K</button
    >
    <a
      href={DEMO}
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center gap-1.5 rounded-md bg-primary px-3 py-1.5 font-semibold text-white transition-colors hover:bg-primary-bright"
    >
      <span aria-hidden="true">▶</span> Live Demo <span aria-hidden="true">→</span>
    </a>
    <span class="cursor-default text-faint select-none" aria-hidden="true">v0.9.29</span>
  </div>
</header>
