---
import Explorer from './Explorer.astro';

interface Props {
  active?: string;
}
const { active = 'home' } = Astro.props;
const DEMO = 'https://app.libredb.org';
---

<header
  class="sticky top-0 z-30 flex h-14 items-center justify-between border-b border-edge bg-canvas/95 px-3 backdrop-blur lg:hidden"
>
  <div class="flex items-center gap-3">
    <button
      type="button"
      class="flex h-9 w-9 items-center justify-center border border-edge-strong text-fg"
      aria-label="Open explorer"
      aria-expanded="false"
      data-drawer-open
    >
      <span aria-hidden="true">☰</span>
    </button>
    <span class="flex items-center gap-2">
      <img src="/logo.svg" alt="LibreDB Studio" class="h-5 w-5" />
      <span class="font-semibold text-bright">LibreDB Studio</span>
    </span>
  </div>
  <a
    href={DEMO}
    target="_blank"
    rel="noopener noreferrer"
    class="flex items-center gap-1.5 rounded-md bg-primary px-3 py-2 text-[13px] font-semibold text-white"
  >
    <span aria-hidden="true">▶</span> Live Demo
  </a>
</header>

<!-- Drawer -->
<div class="fixed inset-0 z-40 hidden lg:hidden" data-drawer-root>
  <div class="absolute inset-0 bg-black/60" data-drawer-close></div>
  <aside
    class="absolute top-0 left-0 h-full w-[84%] max-w-xs -translate-x-full border-r border-edge bg-canvas transition-transform duration-200 ease-out"
    data-drawer-panel
    aria-label="Explorer"
  >
    <div class="flex items-center justify-end border-b border-edge py-1 pr-1 pl-4">
      <button
        type="button"
        class="flex h-10 w-10 items-center justify-center text-faint hover:text-fg"
        aria-label="Close explorer"
        data-drawer-close>✕</button
      >
    </div>
    <div class="h-[calc(100%-49px)]">
      <Explorer active={active} idPrefix="drawer" />
    </div>
  </aside>
</div>
