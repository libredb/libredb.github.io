---
/**
 * Minimal SQL syntax highlighter for the fixed marketing queries.
 * Highlights keywords, strings, numbers, comments — trusted/static input only.
 */
interface Props {
  query: string;
  class?: string;
}
const { query, class: className = '' } = Astro.props;

// Pre-sorted longest-first (once) so highlight() neither sorts nor mutates per call.
const KEYWORDS = [
  'SELECT', 'FROM', 'WHERE', 'ORDER BY', 'GROUP BY', 'DESC', 'ASC', 'LIMIT',
  'AND', 'OR', 'NOT', 'NULL', 'AS', 'IN', 'ON', 'JOIN', 'LEFT', 'INNER',
  'BEGIN', 'COMMIT', 'ROLLBACK', 'INSERT', 'UPDATE', 'DELETE',
].sort((a, b) => b.length - a.length);

const escapeHtml = (s: string) =>
  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

function highlight(sql: string): string {
  let out = escapeHtml(sql);
  // strings
  out = out.replace(/'([^']*)'/g, `<span class="sql-str">'$1'</span>`);
  // keywords (longest first, word boundaries)
  for (const kw of KEYWORDS) {
    const re = new RegExp(`\\b(${kw.replace(/ /g, '\\s+')})\\b`, 'gi');
    out = out.replace(re, '<span class="sql-kw">$1</span>');
  }
  // numbers
  out = out.replace(/\b(\d+)\b/g, '<span class="sql-num">$1</span>');
  // star + semicolon punctuation stay as fg (default)
  return out;
}
---
<code class={`font-mono ${className}`} set:html={highlight(query)} />
