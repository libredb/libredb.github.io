---
import type { SectionMeta } from '../../data/sections';
import Sql from './Sql.astro';

interface Props {
  section: SectionMeta;
  class?: string;
}
const { section, class: className = '' } = Astro.props;

// Gags tucked one click deeper — every item keeps its in-character console notice.
const moreTabs = [
  { action: 'notice', notice: 'saved', label: 'Saved' },
  { action: 'notice', notice: 'charts', label: 'Charts' },
  { action: 'palette', notice: '', label: 'NL2SQL' },
  { action: 'notice', notice: 'pivot', label: 'Pivot' },
  { action: 'notice', notice: 'diff', label: 'Diff' },
  { action: 'notice', notice: 'dashboard', label: 'Dashboard' },
];
---

<div class:list={['shrink-0 border-b border-edge bg-canvas', className]}>
  <!-- Tab bar -->
  <div class="flex items-center gap-0 border-b border-edge text-[13px]">
    <span
      class="flex items-center gap-2 border-r border-edge bg-panel px-4 py-2.5 text-fg shadow-[inset_0_-1px_0_var(--color-primary)]"
    >
      <span class="text-primary" aria-hidden="true">#</span>
      {section.table}.sql
      <button
        type="button"
        class="text-faint hover:text-fg"
        data-action="notice"
        data-notice="closetab"
        aria-label="Close tab">✕</button
      >
    </span>
    <span
      class="cursor-pointer px-3 py-2.5 text-faint select-none hover:text-fg"
      data-action="notice"
      data-notice="newtab"
      aria-hidden="true">＋</span
    >
  </div>

  <!-- Toolbar (single strip: just RUN) -->
  <div class="flex items-center gap-3 px-4 py-2 text-[12px]">
    <button
      type="button"
      class="flex items-center gap-1.5 rounded-md bg-primary px-4 py-1.5 font-semibold text-white hover:bg-primary-bright"
      data-action="run"
      data-run
    >
      <span aria-hidden="true">▶</span> RUN
    </button>
    <span class="rounded border border-edge-strong px-1.5 py-0.5 text-[11px] text-faint" aria-hidden="true"
      >⌘+Enter</span
    >
  </div>

  <!-- Editor -->
  <div class="flex items-start gap-4 border-t border-edge px-4 py-4 text-[15px] leading-relaxed">
    <span class="text-faint select-none" aria-hidden="true">1</span>
    <div><Sql query={section.query} /><span class="caret"></span></div>
  </div>

  <!-- Results tabs -->
  <div class="flex items-center gap-4 border-t border-edge px-4 py-2.5 text-[12px]">
    <button
      type="button"
      class="pb-0.5 font-semibold whitespace-nowrap text-fg shadow-[inset_0_-1px_0_var(--color-primary)]"
      data-action="results"><span aria-hidden="true">▦</span> Results</button
    >
    <button
      type="button"
      class="whitespace-nowrap text-muted hover:text-fg"
      data-action="explain"
      aria-expanded="false"
      aria-controls={`explain-${section.id}`}><span class="text-ai" aria-hidden="true">✦</span> Explain</button
    >
    <span
      class="cursor-pointer whitespace-nowrap text-faint select-none hover:text-fg"
      data-action="notice"
      data-notice="history"
      aria-hidden="true">History</span
    >
    <button
      type="button"
      class="whitespace-nowrap text-faint hover:text-fg"
      data-action="notice"
      data-notice="autopilot">Autopilot</button
    >
    <details class="relative" data-chrome-menu>
      <summary class="cursor-pointer text-faint select-none hover:text-fg" aria-label="More result views">⋯</summary>
      <div
        class="absolute bottom-full left-0 z-30 mb-1 flex w-36 flex-col border border-edge-strong bg-panel py-1 shadow-lg"
      >
        {
          moreTabs.map((tab) => (
            <button
              type="button"
              class="px-3 py-1.5 text-left text-muted hover:bg-raised hover:text-fg"
              data-action={tab.action}
              data-notice={tab.notice || undefined}
            >
              {tab.label}
            </button>
          ))
        }
      </div>
    </details>
  </div>
</div>
