---
import { sections } from '../../data/sections';
import { schemas } from '../../data/schemas';

interface Props {
  active?: string;
  idPrefix?: string; // to keep ids unique between desktop sidebar & mobile drawer
}
const { active = 'home', idPrefix = 'exp' } = Astro.props;
---

<div data-explorer-root class="flex h-full flex-col text-[13px]">
  <!-- Search (filters the tree) -->
  <div class="px-3 py-2 pt-3">
    <label class="sr-only" for={`${idPrefix}-search`}>Search pages or sections</label>
    <input
      id={`${idPrefix}-search`}
      type="text"
      placeholder="⌕"
      class="w-full border border-edge bg-canvas px-3 py-1.5 text-[12px] text-fg placeholder:text-faint focus:border-primary focus:outline-none"
      data-explorer-search
    />
  </div>

  <!-- Tree -->
  <nav class="flex-1 overflow-y-auto px-2 pb-3" aria-label="Schema explorer">
    {
      schemas.map((schema) => (
        <div class="mb-1">
          <div class="flex items-center gap-1.5 px-2 py-1 text-muted">
            <>
              <span aria-hidden="true">▾</span>
              <span aria-hidden="true">▦</span>
            </>
            <span>{schema.label}</span>
            {schema.badge && <span class:list={['ml-1 text-[11px] lowercase', schema.badgeClass]}>{schema.badge}</span>}
          </div>

          <ul class="mt-0.5">
            {sections
              .filter((s) => s.schema === schema.id)
              .map((s) => (
                <li data-explorer-item={s.id}>
                  <div class:list={['exp-row group flex items-center gap-1 pr-2', active === s.id && 'active']}>
                    <button
                      type="button"
                      class="flex h-9 w-8 shrink-0 items-center justify-center text-faint hover:text-fg lg:h-7 lg:w-6"
                      aria-expanded="false"
                      aria-label={`Toggle ${s.table} columns`}
                      aria-controls={`${idPrefix}-cols-${s.id}`}
                      data-explorer-toggle={s.id}
                      tabindex="-1"
                    >
                      <span class="caret-icon" aria-hidden="true">
                        ▸
                      </span>
                    </button>
                    <a
                      href={s.slug === '' ? '/' : `/${s.slug}`}
                      class="flex flex-1 items-center justify-between gap-2 py-1.5 pr-1 pl-0.5"
                      data-section-link={s.id}
                    >
                      <span class="flex items-center gap-2 truncate">
                        <span class="text-dim" aria-hidden="true">
                          ▤
                        </span>
                        <span class="truncate">{s.table}</span>
                      </span>
                      <span class="text-[11px] text-faint">{s.rows}</span>
                    </a>
                  </div>
                  <ul class="hidden pb-1 pl-9" id={`${idPrefix}-cols-${s.id}`} data-explorer-cols={s.id}>
                    {s.columns.map((c) => (
                      <li class="flex items-center justify-between py-1 pr-3 text-[12px]">
                        <span class="flex items-center gap-2 text-muted">
                          <span class="text-dim" aria-hidden="true">
                            ◆
                          </span>
                          {c.name}
                        </span>
                        <span class="text-[11px] tracking-wide text-faint uppercase">{c.type}</span>
                      </li>
                    ))}
                  </ul>
                </li>
              ))}
            {schema.external && (
              <li>
                <a
                  href={schema.external.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="exp-row group flex items-center justify-between gap-2 py-1.5 pr-3 pl-8"
                >
                  <span class="flex items-center gap-2 truncate text-muted">
                    <span class="text-dim" aria-hidden="true">
                      ↗
                    </span>
                    <span class="truncate">{schema.external.label}</span>
                  </span>
                  <span class="text-[11px] text-faint" aria-hidden="true">
                    ↗
                  </span>
                </a>
              </li>
            )}
          </ul>
        </div>
      ))
    }
  </nav>
</div>
