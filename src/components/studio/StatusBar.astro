---
import { sectionById } from '../../data/sections';
interface Props { active?: string; }
const { active = 'home' } = Astro.props;
const meta = sectionById[active] ?? sectionById['home'];
---
<footer class="flex h-7 shrink-0 items-center justify-between border-t border-edge bg-panel px-4 text-[11.5px] text-dim cursor-default select-none">
  <div class="flex items-center gap-4">
    <span class="flex items-center gap-1.5 text-ok">
      <span class="h-1.5 w-1.5 rounded-full bg-ok" aria-hidden="true"></span> Connected
    </span>
    <span class="text-faint">LibreDB:latest</span>
    <span class="text-faint">public</span>
    <span class="text-muted"><span data-statusbar-table>{meta.table}</span>.sql</span>
  </div>
  <div class="flex items-center gap-4">
    <nav class="flex items-center gap-3" aria-label="Quick links">
      <a href="https://github.com/libredb/libredb-studio" target="_blank" rel="noopener noreferrer" class="cursor-pointer hover:text-fg">GitHub</a>
      <a href="https://www.linkedin.com/company/libredb" target="_blank" rel="noopener noreferrer" class="cursor-pointer hover:text-fg">LinkedIn</a>
      <a href="https://github.com/sponsors/libredb" target="_blank" rel="noopener noreferrer" class="cursor-pointer text-ok hover:text-fg">Sponsor ♥</a>
      <a href="/privacy-policy" class="cursor-pointer hover:text-fg">Privacy</a>
    </nav>
    <span class="text-faint" aria-hidden="true">·</span>
    <span><span data-statusbar-rows>{meta.rows}</span> rows</span>
    <span class="text-faint">Ln 1, Col 1</span>
    <span class="text-faint">UTF-8</span>
    <span class="text-faint">SQL</span>
    <span class="flex items-center gap-1.5 text-muted"><span class="text-primary" aria-hidden="true">◆</span> LibreDB Studio v0.9.29</span>
  </div>
</footer>
