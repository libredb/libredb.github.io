---
/**
 * Lucide-style icons, inlined. 24px grid, 1.5px stroke, round caps and joins,
 * `currentColor` only — the design system's iconography rules. Path data is
 * copied from the prototype so the drawn shapes are identical.
 */
interface Props {
  name: 'code' | 'share' | 'diagram' | 'sparkles' | 'activity' | 'bot';
  size?: number;
  class?: string;
}
const { name, size = 20, class: klass } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  class={klass}
>
  {
    name === 'code' && (
      <>
        <path d="m16 18 6-6-6-6" />
        <path d="m8 6-6 6 6 6" />
      </>
    )
  }
  {
    name === 'share' && (
      <>
        <circle cx="18" cy="6" r="3" />
        <circle cx="6" cy="18" r="3" />
        <path d="M6 3v12" />
        <path d="M18 9a9 9 0 0 1-9 9" />
      </>
    )
  }
  {
    name === 'diagram' && (
      <>
        <rect x="3" y="3" width="8" height="8" rx="2" />
        <path d="M7 11v4a2 2 0 0 0 2 2h4" />
        <rect x="13" y="13" width="8" height="8" rx="2" />
      </>
    )
  }
  {
    name === 'sparkles' && (
      <>
        <path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z" />
        <path d="M20 2v4" />
        <path d="M22 4h-4" />
      </>
    )
  }
  {name === 'activity' && <path d="M22 12h-4l-3 9L9 3l-3 9H2" />}
  {
    name === 'bot' && (
      <>
        <path d="M12 8V4H8" />
        <rect x="4" y="8" width="16" height="12" rx="2" />
        <path d="M2 14h2" />
        <path d="M20 14h2" />
        <path d="M15 13v2" />
        <path d="M9 13v2" />
      </>
    )
  }
</svg>
