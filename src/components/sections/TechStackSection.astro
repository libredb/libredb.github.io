---
import SectionHeader from './SectionHeader.astro';

interface Layer {
  layer: string;
  color: string;
  tools: { name: string; role: string }[];
}

const layers: Layer[] = [
  {
    layer: 'FRONTEND',
    color: 'text-bright',
    tools: [
      { name: 'Next.js 16', role: 'App Router' },
      { name: 'React 19', role: 'Server Components' },
      { name: 'TypeScript', role: 'Type Safety' },
      { name: 'Tailwind CSS 4', role: 'Styling' },
    ],
  },
  {
    layer: 'EDITOR & DATA',
    color: 'text-bright',
    tools: [
      { name: 'Monaco Editor', role: 'VS Code Engine' },
      { name: 'TanStack Table', role: 'Data Grid' },
      { name: 'ReactFlow', role: 'ER Diagrams' },
      { name: 'Recharts', role: 'Charts & Profiling' },
    ],
  },
  {
    layer: 'AI & AUTH',
    color: 'text-bright',
    tools: [
      { name: 'Gemini 2.5', role: 'Default LLM' },
      { name: 'OpenAI / Claude', role: 'Alternatives' },
      { name: 'Ollama / LM Studio', role: 'Local LLMs' },
      { name: 'JWT / OIDC / RBAC', role: 'Auth & SSO' },
    ],
  },
  {
    layer: 'DEVOPS',
    color: 'text-bright',
    tools: [
      { name: 'Docker', role: 'Container' },
      { name: 'Kubernetes', role: 'Orchestration' },
      { name: 'Bun', role: 'Runtime' },
    ],
  },
];
---

<div class="mx-auto max-w-6xl">
  <SectionHeader title="Built with modern tech" subtitle="Production-ready stack for performance and scalability." />

  <div class="grid grid-cols-1 gap-px overflow-hidden border border-edge bg-edge sm:grid-cols-2 lg:grid-cols-4">
    {
      layers.map((l) => (
        <div class="bg-panel p-5">
          <span class={`text-[11px] font-semibold tracking-wider uppercase ${l.color}`}>{l.layer}</span>
          <ul class="mt-4 space-y-3">
            {l.tools.map((t) => (
              <li>
                <div class="text-[14px] font-semibold text-fg">{t.name}</div>
                <div class="text-[12px] text-faint">{t.role}</div>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</div>
<script
  type="application/json"
  data-export-payload="tech_stack"
  data-export-filename="tech_stack.json"
  data-export-format="json"
  set:html={JSON.stringify(layers)}
/>
