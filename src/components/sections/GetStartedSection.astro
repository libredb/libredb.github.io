---
import SectionHeader from './SectionHeader.astro';

interface Line {
  kind: 'cmd' | 'comment' | 'out';
  text: string;
}
interface Step {
  n: number;
  title: string;
  lines: Line[];
}

const steps: Step[] = [
  {
    n: 1,
    title: 'Clone & Install',
    lines: [
      { kind: 'cmd', text: 'git clone https://github.com/libredb/libredb-studio.git' },
      { kind: 'cmd', text: 'cd libredb-studio' },
      { kind: 'cmd', text: 'bun install' },
    ],
  },
  {
    n: 2,
    title: 'Configure',
    lines: [
      { kind: 'cmd', text: 'cp .env.example .env.local' },
      { kind: 'comment', text: '# set JWT_SECRET (32+ chars),' },
      { kind: 'comment', text: '# admin/user creds, LLM provider' },
      { kind: 'cmd', text: 'LLM_PROVIDER=ollama' },
    ],
  },
  {
    n: 3,
    title: 'Launch',
    lines: [
      { kind: 'cmd', text: 'bun dev' },
      { kind: 'out', text: '→ localhost:3000' },
      { kind: 'comment', text: '# or: docker compose up -d' },
    ],
  },
];

const lineClass = (k: Line['kind']) => (k === 'comment' ? 'text-faint' : k === 'out' ? 'text-ok' : 'text-fg');

// Copyable text = the commands and their comments, skipping program output.
const copyText = (s: Step) =>
  s.lines
    .filter((l) => l.kind !== 'out')
    .map((l) => l.text)
    .join('\n');
---

<div class="mx-auto max-w-6xl">
  <SectionHeader title="Get started in minutes" subtitle="Up and running with three simple steps." />

  <div class="grid grid-cols-1 gap-4 lg:grid-cols-3">
    {
      steps.map((s) => (
        <article class="group relative flex flex-col border border-edge bg-panel">
          <div class="flex items-center gap-3 border-b border-edge px-4 py-3">
            <span class="flex h-7 w-7 shrink-0 items-center justify-center bg-primary text-[13px] font-bold text-white">
              {s.n}
            </span>
            <h3 class="text-[15px] font-semibold text-bright">{s.title}</h3>
            <button
              class="copy-btn ml-auto inline-flex items-center gap-1.5 rounded-md border border-edge-strong px-2 py-1 text-[12px] text-dim opacity-100 transition-all duration-200 hover:bg-raised hover:text-fg md:opacity-0 md:group-hover:opacity-100"
              data-code={copyText(s)}
              aria-label={`Copy ${s.title} commands`}
            >
              <svg class="copy-icon h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"
                />
              </svg>
              <svg class="check-icon hidden h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="copy-label">Copy</span>
            </button>
          </div>
          <div class="flex-1 px-4 py-4 font-mono text-[12.5px] leading-relaxed">
            {s.lines.map((l) => (
              <span class={`block break-words whitespace-pre-wrap ${lineClass(l.kind)}`}>
                {l.kind === 'cmd' ? <span class="text-primary select-none">$ </span> : ''}
                {l.text}
              </span>
            ))}
          </div>
        </article>
      ))
    }
  </div>

  <!-- Docker + one-click pointers (content preserved from original Get Started) -->
  <div class="mt-4 grid grid-cols-1 gap-4 lg:grid-cols-2">
    <div class="flex flex-col justify-between gap-3 border border-edge bg-panel p-5">
      <div>
        <h3 class="text-[15px] font-semibold text-bright">Prefer Docker?</h3>
        <p class="mt-1 text-[13px] text-dim">One command to run anywhere.</p>
      </div>
      <div class="group relative">
        <code
          class="block overflow-x-auto rounded-sm bg-canvas py-2 pr-10 pl-3 font-mono text-[12.5px] whitespace-nowrap text-fg"
          ><span class="text-primary select-none">$ </span>docker compose up -d</code
        >
        <button
          class="copy-btn absolute top-1/2 right-2 -translate-y-1/2 rounded-md p-1 text-dim opacity-100 transition-all duration-200 hover:bg-edge-strong hover:text-fg md:opacity-0 md:group-hover:opacity-100"
          data-code="docker compose up -d"
          aria-label="Copy the docker compose command"
        >
          <svg class="copy-icon h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"
            ></path>
          </svg>
          <svg class="check-icon hidden h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
          </svg>
        </button>
      </div>
      <a href="/docker-compose-example" class="text-[13px] text-primary hover:underline"
        >View the full docker-compose.example.yml →</a
      >
    </div>
    <div class="flex flex-col justify-between gap-3 border border-edge bg-panel p-5">
      <div>
        <h3 class="text-[15px] font-semibold text-bright">Prefer a one-click deploy?</h3>
        <p class="mt-1 text-[13px] leading-relaxed text-dim">
          LibreDB Studio is an official Railway template, CapRover one-click app, and Dokploy marketplace template — and
          runs on Docker, Helm, npm, and every major PaaS and cloud.
        </p>
      </div>
      <a href="/deploy" class="text-[13px] text-primary hover:underline">Explore all deploy options →</a>
    </div>
  </div>

  <!-- The first real step AFTER the app is running -->
  <section class="mt-10 border border-edge bg-panel p-6">
    <h3 class="text-[15px] font-semibold text-bright">Next: connect your first database</h3>
    <ol class="mt-4 flex list-none flex-col gap-3 text-[13px] leading-relaxed text-muted">
      <li>
        <span class="text-faint select-none">1&nbsp;</span> Log in and open
        <span class="font-semibold text-fg">Connections → New connection</span>.
      </li>
      <li>
        <span class="text-faint select-none">2&nbsp;</span> Pick your engine — PostgreSQL, MySQL, Oracle, SQL Server, SQLite,
        MongoDB, or Redis.
      </li>
      <li>
        <span class="text-faint select-none">3&nbsp;</span> Enter host and credentials.
        <span class="text-dim">Start with a dedicated read-only database account</span> — least privilege first, write access
        when you actually need it. Databases behind a firewall connect over an SSH tunnel.
      </li>
      <li>
        <span class="text-faint select-none">4&nbsp;</span> Deploying for a team? Define
        <span class="font-semibold text-fg">seed connections</span> whose credentials resolve from environment variables at
        runtime — secrets stay in your secret manager, never in a config file.
      </li>
    </ol>
    <div class="mt-5 flex flex-wrap gap-4 text-[13px]">
      <a
        href="https://github.com/libredb/libredb-studio/blob/main/docs/SEED_CONNECTIONS.md"
        target="_blank"
        rel="noopener noreferrer"
        class="text-primary hover:underline">Seed connections guide →</a
      >
      <a href="/security" class="text-primary hover:underline">How credentials are handled →</a>
    </div>
  </section>
</div>
<script
  type="application/json"
  data-export-payload="get_started"
  data-export-filename="get_started.json"
  data-export-format="json"
  set:html={JSON.stringify(steps)}
/>
<script data-astro-rerun>
  document.querySelectorAll('.copy-btn').forEach((button) => {
    button.addEventListener('click', async () => {
      const code = button.getAttribute('data-code');
      const copyIcon = button.querySelector('.copy-icon');
      const checkIcon = button.querySelector('.check-icon');
      const label = button.querySelector('.copy-label');

      try {
        await navigator.clipboard.writeText(code || '');
        copyIcon?.classList.add('hidden');
        checkIcon?.classList.remove('hidden');
        button.classList.add('text-ok');
        if (label) label.textContent = 'Copied';

        setTimeout(() => {
          copyIcon?.classList.remove('hidden');
          checkIcon?.classList.add('hidden');
          button.classList.remove('text-ok');
          if (label) label.textContent = 'Copy';
        }, 2000);
      } catch (err) {
        console.error('Failed to copy:', err);
      }
    });
  });
</script>
