---
import SectionHeader from './SectionHeader.astro';

type Score = true | false | 'partial';
const criteria = ['ZERO_INSTALL', 'MOBILE', 'AI_NATIVE', 'SSO_OIDC', 'FREE'];
const chipLabels = ['install', 'mobile', 'ai', 'sso', 'free'];

interface Row {
  tool: string;
  recommended?: boolean;
  scores: Score[];
  price: string;
  priceClass: string;
}

const rows: Row[] = [
  {
    tool: 'LibreDB Studio',
    recommended: true,
    scores: [true, true, true, true, true],
    price: '$0',
    priceClass: 'text-ok',
  },
  {
    tool: 'DataGrip',
    scores: [false, false, false, false, false],
    price: '$199/yr',
    priceClass: 'text-faint',
  },
  {
    tool: 'DBeaver',
    scores: [false, false, false, false, 'partial'],
    price: 'Free / Pro',
    priceClass: 'text-faint',
  },
  {
    tool: 'pgAdmin',
    scores: ['partial', false, false, false, true],
    price: 'PG only',
    priceClass: 'text-faint',
  },
  {
    tool: 'TablePlus',
    scores: [false, false, false, false, false],
    price: '$89',
    priceClass: 'text-faint',
  },
];

const scoreText = (s: Score) => (s === 'partial' ? 'partial' : String(s));
const scoreClass = (s: Score) => (s === true ? 'text-ok' : s === 'partial' ? 'text-warn' : 'text-bad');

const exportRows = rows.map((r) => ({
  tool: r.tool,
  recommended: r.recommended ?? false,
  zero_install: r.scores[0],
  mobile: r.scores[1],
  ai_native: r.scores[2],
  sso_oidc: r.scores[3],
  free: r.scores[4],
  price: r.price,
}));
---

<div class="mx-auto max-w-6xl">
  <SectionHeader title="How we compare" subtitle="See why teams are switching to LibreDB Studio." />

  <!-- Desktop: result table -->
  <div class="hidden overflow-x-auto border border-edge lg:block">
    <table class="w-full border-collapse text-[13px]">
      <thead>
        <tr class="border-b border-edge bg-panel text-left text-[11px] tracking-wider text-dim uppercase">
          <th class="px-5 py-3 font-medium">TOOL</th>
          {criteria.map((c) => <th class="px-5 py-3 text-center font-medium">{c}</th>)}
          <th class="px-5 py-3 text-right font-medium">PRICE</th>
        </tr>
      </thead>
      <tbody>
        {
          rows.map((r) => (
            <tr
              class:list={[
                'border-b border-edge last:border-b-0',
                r.recommended ? 'bg-primary/5' : 'hover:bg-raised/50',
              ]}
            >
              <td class="px-5 py-3.5 font-semibold whitespace-nowrap text-bright">
                {r.tool}
                {r.recommended && <span class="ml-2 text-[11px] font-normal text-primary">★ recommended</span>}
              </td>
              {r.scores.map((s) => (
                <td class={`px-5 py-3.5 text-center font-medium ${scoreClass(s)}`}>{scoreText(s)}</td>
              ))}
              <td class={`px-5 py-3.5 text-right font-semibold ${r.priceClass}`}>{r.price}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <!-- Mobile: stacked cards -->
  <div class="flex flex-col gap-3 lg:hidden">
    {
      rows.map((r) => (
        <article class:list={['border border-edge bg-panel p-4', r.recommended && 'border-primary/40']}>
          <h3 class="flex items-center gap-2 text-[15px] font-bold text-bright">
            {r.tool}
            {r.recommended && <span class="text-[11px] font-normal text-primary">★</span>}
          </h3>
          <div class="mt-3 flex flex-wrap gap-2">
            {r.scores.map((s, i) => (
              <span class="inline-flex items-center gap-1.5 border border-edge px-2 py-1 text-[12px] text-dim">
                {chipLabels[i]} <span class={`font-semibold ${scoreClass(s)}`}>{scoreText(s)}</span>
              </span>
            ))}
            <span class="inline-flex items-center gap-1.5 border border-edge px-2 py-1 text-[12px] text-dim">
              price <span class={`font-semibold ${r.priceClass === 'text-ok' ? 'text-ok' : 'text-fg'}`}>{r.price}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>

  <p class="mt-6 text-[13px] leading-relaxed">
    <span class="sql-com">
      -- methodology: scored by the LibreDB team from each tool's public docs and pricing pages (last check:
      2026-07-15). spotted an error?
    </span>
    <a
      href="https://github.com/libredb/libredb-studio/issues"
      target="_blank"
      rel="noopener noreferrer"
      class="text-muted hover:text-fg">file an issue →</a
    >
  </p>
</div>
<script
  type="application/json"
  data-export-payload="compare"
  data-export-filename="compare.csv"
  data-export-format="csv"
  set:html={JSON.stringify(exportRows)}
/>
