  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@types/bun": "^1.3.14",
    "knip": "6.22.0",
    "oxlint": "1.71.0",
    "prettier": "3.9.0",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "0.8.0",
    "typescript": "6.0.3"
  }
}
