{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "plugins": ["typescript", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "off",
    "pedantic": "off",
    "style": "off"
  },
  "rules": {
    "no-underscore-dangle": "off"
  },
  "ignorePatterns": ["dist/**", ".astro/**", "node_modules/**", "public/**"]
}
